@@ -26,12 +26,42 @@ import type { ToolResult } from "./index"
 
 export const searchOrdersTool: ToolDefinition = {
   type: "function",
-  function: { name: "search_orders", description: "Not built yet: RD-602", parameters: { type: "object", properties: {} } },
+  function: {
+    name: "search_orders",
+    description: "Searches a customer's orders by product name and returns the matching order.",
+    parameters: {
+      type: "object",
+      properties: {
+        customerId: { type: "string", description: "The customer whose orders to search, like C-0134." },
+        product: { type: "string", description: "Part of a product name, like kettle." },
+      },
+      required: ["customerId", "product"],
+    },
+  },
 }
 
+type FoundOrder = { id: string; placedAt: string; products: string[] }
+
 export async function searchOrders(rawArgs: string, shop: Shop, ctx: { customerId: string }): Promise<ToolResult> {
-  void rawArgs
-  void shop
-  void ctx
-  throw new Error("Not built yet: RD-602")
+  let args: { customerId?: string; product: string }
+  try {
+    args = JSON.parse(rawArgs)
+  } catch {
+    return { ok: false, error: { code: "invalid_arguments", message: "The arguments are not valid JSON." } }
+  }
+  // The model knows which customer it is helping, so it passes the id.
+  const customerId = args.customerId ?? ctx.customerId
+  const wanted = args.product.trim()
+  // listOrders returns the newest order first.
+  const orders = await shop.listOrders({ customerId })
+  const found: FoundOrder[] = orders
+    .map((o) => ({ id: o.id, placedAt: o.placedAt, products: o.items.map((it) => productName(shop, it.productId)) }))
+    .filter((o) => o.products.some((name) => name.includes(wanted)))
+  // When several orders fit, the newest is almost always the one the
+  // customer means, and returning only that one saves the model a step.
+  return { ok: true, data: found.slice(0, 1) }
+}
+
+function productName(shop: Shop, productId: string): string {
+  return shop.data.products.find((p) => p.id === productId)?.name ?? productId
 }
