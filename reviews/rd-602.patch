diff --git a/src/agent/tools/search.test.ts b/src/agent/tools/search.test.ts
new file mode 100644
index 0000000..bb8e919
--- /dev/null
+++ b/src/agent/tools/search.test.ts
@@ -0,0 +1,32 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { Shop } from "../../server/shop/api"
+import { searchOrders, searchOrdersTool } from "./search"
+
+const shop = new Shop({ faults: false })
+
+test("the tool is described to the model", () => {
+  assert.equal(searchOrdersTool.function.name, "search_orders")
+  assert.ok(searchOrdersTool.function.description.length > 0)
+})
+
+test("finds the order with the product", async () => {
+  const r = await searchOrders(JSON.stringify({ customerId: "C-0002", product: "Rice cooker" }), shop, { customerId: "C-0002" })
+  assert.deepEqual(r.ok && (r.data as { id: string }[]).map((o) => o.id), ["FH-101174"])
+})
+
+test("no order has the product", async () => {
+  const r = await searchOrders(JSON.stringify({ customerId: "C-0002", product: "Sofa" }), shop, { customerId: "C-0002" })
+  assert.deepEqual(r.ok && r.data, [])
+})
+
+test("picks the newest order when several fit", async () => {
+  const r = await searchOrders(JSON.stringify({ customerId: "C-0061", product: "kettle" }), shop, { customerId: "C-0061" })
+  assert.deepEqual(r.ok && (r.data as { id: string }[]).map((o) => o.id), ["FH-101117"])
+})
+
+test("arguments that aren't JSON are refused", async () => {
+  const r = await searchOrders("{oops", shop, { customerId: "C-0002" })
+  assert.equal(r.ok, false)
+})
